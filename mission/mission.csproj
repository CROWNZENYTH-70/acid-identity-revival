<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Override: dotnet run -p:ManagedDir=PATH (your decoded APK Managed dir) -->
    <ManagedDir Condition="'$(ManagedDir)' == ''">../apk_out/assets/bin/Data/Managed</ManagedDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="protobuf-net">
      <HintPath>$(ManagedDir)/protobuf-net.dll</HintPath>
    </Reference>
    <Reference Include="AcierProtocol">
      <HintPath>$(ManagedDir)/AcierProtocol.dll</HintPath>
    </Reference>
    <Reference Include="AcierProtocolSerializer">
      <HintPath>$(ManagedDir)/AcierProtocolSerializer.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
